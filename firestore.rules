rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signaling data (offer/answer/ICE candidates) - short-lived, low risk.
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    // Matchmaking queue.
    match /queue/{docId} {
      allow read, write: if true;
    }
    // Leaderboard.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }
    // Kullanıcı hesapları (kullanıcı adı, şifre hash+salt, sessionToken, profil fotoğrafı).
    match /users/{username} {
      allow read, write: if true;
    }
    // Arkadaş listesi.
    match /friends/{docId} {
      allow read, write: if true;
    }
    // Maç geçmişi.
    match /matchHistory/{docId} {
      allow read, write: if true;
    }
    // Arkadaşa doğrudan maç daveti (revanş dahil).
    match /matchInvites/{docId} {
      allow read, write: if true;
    }
    // Arkadaşlık istekleri (kabul/red akışı).
    match /friendRequests/{docId} {
      allow read, write: if true;
    }
  }
}
