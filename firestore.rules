rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signaling data (offer/answer/ICE candidates) - short-lived, low risk.
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Matchmaking queue.
    match /queue/{docId} {
      allow read, write: if true;
    }

    // Leaderboard.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
