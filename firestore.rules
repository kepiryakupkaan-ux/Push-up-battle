rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signaling data (offer/answer/ICE candidates) - short-lived, low risk.
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Matchmaking queue.
    match /queue/{docId} {
      allow read, write: if true;
    }

    // Leaderboard.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    // Kullanıcı hesapları (kullanıcı adı, şifre hash+salt, sessionToken, profil fotoğrafı).
    // NOT: Bu kurallar tamamen açık - projenin geri kalanıyla aynı felsefe (küçük arkadaş
    // grubu). Herkes passwordHash+salt'ı okuyabilir; halka açık/büyük ölçekli bir kullanım
    // için gerçek bir Auth sistemine (Firebase Auth vb.) geçmek gerekir.
    match /users/{username} {
      allow read, write: if true;
    }
  }
}
